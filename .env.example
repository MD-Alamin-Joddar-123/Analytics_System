# Universal Ecommerce Analytics — Backend environment configuration.
# Copy this file to `.env` and fill in real values for your environment.
# NEVER commit `.env` itself — only this example file belongs in source
# control. See README.md's "Environment Variables" table and
# docs/PRODUCTION_INTEGRATION_GUIDE.md for the full explanation of each
# variable's purpose and production considerations.

# --- Server -------------------------------------------------------------
# Port the HTTP API listens on.
PORT=5000
# development | production | test — gates stack-trace exposure in error
# responses (dev only), the test-suite rate-limiter bypass, and a few
# other environment-specific behaviors documented inline where used.
NODE_ENV=development

# --- Database -------------------------------------------------------------
# MongoDB connection string. In production, use a credentialed URI
# (mongodb+srv://user:pass@host/db) over TLS — never a bare local
# connection string like the default below outside of local development.
# This value is NEVER exposed to the frontend, the dashboard, tracking.js,
# or any API response — it exists only in this file/the process env.
MONGODB_URI=mongodb://127.0.0.1:27017/universal_analytics

# --- CORS -----------------------------------------------------------------
# Comma-separated list of origins allowed to call the AUTHENTICATED API
# (auth, websites, reporting) with credentials — this is your dashboard
# frontend's own origin(s), not customer websites. Leave empty to allow
# any origin (NOT recommended in production). This does NOT restrict
# POST /api/collect or GET /tracking.js, which intentionally serve any
# origin by design (see docs/SDK_ARCHITECTURE.md) — a tracking script and
# collector that only worked from an allow-listed origin would defeat the
# entire point of a universal, embeddable SDK.
CORS_ORIGINS=http://localhost:3000

# --- Authentication (Phase 2) ----------------------------------------------
# Secret used to sign/verify dashboard JWTs. MUST be a long, random,
# unguessable value in production (e.g. `openssl rand -base64 48`) — never
# reuse the placeholder below outside local development. Never logged,
# never returned in any API response, never present in the frontend
# dashboard or tracking.js bundles.
JWT_SECRET=replace_with_a_long_random_secret
# JWT access token lifetime (jsonwebtoken `expiresIn` format, e.g. "7d", "1h").
JWT_EXPIRES_IN=7d

# --- Visitor/session resolution (Phase 5) ----------------------------------
# Inactivity window (minutes) before a session is considered expired and a
# new one is started on the next event.
SESSION_TIMEOUT_MINUTES=30

# --- Queue / worker (Phase 7) -----------------------------------------------
# Redis connection string, used by both the API process (queue producer)
# and the separate worker process (queue consumer) — see "npm run worker"
# in README.md. Like MONGODB_URI, never exposed to any client-facing
# surface.
REDIS_URL=redis://127.0.0.1:6379
# How many event-processing jobs one worker process handles concurrently.
WORKER_CONCURRENCY=5
# Run the event worker INSIDE the API process instead of as a separate
# `npm run start:worker` process. Leave false when you can run a dedicated
# worker service (better failure isolation and independent scaling); set to
# true on hosting plans that only allow one always-on process (e.g. a free
# tier with no background-worker option). Without either a separate worker
# process OR this set to true, events are collected but never processed,
# and the dashboard stays empty.
EMBED_WORKER=false
# Max processing attempts per event before it's left in a `failed` state
# (still durably recorded, never silently discarded — see
# docs/QUEUE_ARCHITECTURE.md).
QUEUE_ATTEMPTS=5
# Base exponential backoff delay (ms) between retries — attempt N waits
# roughly QUEUE_BACKOFF * 2^(N-1).
QUEUE_BACKOFF=1000

# --- Related projects (not read by this backend — documented here for
# operational completeness; see docs/PRODUCTION_INTEGRATION_GUIDE.md) -----
# The dashboard frontend (frontend/) has its OWN .env — see
# frontend/.env.example — with a single variable, VITE_API_BASE_URL,
# pointing at this backend's public URL. It is a build-time value baked
# into the dashboard's static bundle, not something this backend reads.
#
# There is no separate "tracking SDK URL" environment variable anywhere:
# the tracking script is served BY this backend at GET /tracking.js
# (frontend/sdk/ builds directly into backend/public/tracking.js — see
# docs/SDK_ARCHITECTURE.md §2), and the SDK derives the collector endpoint
# from its own <script src> at runtime (docs/SDK_ARCHITECTURE.md §4) — a
# customer's installation snippet only ever needs this backend's public
# domain, e.g. <script src="https://analytics.yourdomain.com/tracking.js"
# data-website-id="...">, nothing configured separately.
